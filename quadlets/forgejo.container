[Unit]
Description=Forgejo (self-hosted git)
PartOf=homelab.target

[Container]
# Pin the major version: Forgejo upgrades X -> X+1 need a manual check.
# Check https://forgejo.org/releases/ and bump when you're ready.
Image=codeberg.org/forgejo/forgejo:15-rootless
ContainerName=forgejo
PublishPort=8094:3000
PublishPort=2222:2222
Volume=%h/forgejo/data:/var/lib/gitea:Z,U
Volume=%h/forgejo/config:/etc/gitea:Z,U
Environment=TZ=Europe/Belgrade
Environment=FORGEJO__database__DB_TYPE=sqlite3
Environment=FORGEJO__server__DOMAIN=mia-search.local
Environment=FORGEJO__server__ROOT_URL=http://mia-search.local:8094/
Environment=FORGEJO__server__SSH_DOMAIN=mia-search.local
Environment=FORGEJO__server__SSH_PORT=2222
Environment=FORGEJO__server__SSH_LISTEN_PORT=2222
Environment=FORGEJO__service__DISABLE_REGISTRATION=true
Environment=FORGEJO__actions__ENABLED=true
# Keep it from starving the other containers on a 1 GB board
PodmanArgs=--memory=384m
# Auto-update is off on purpose: major upgrades need a human.
# AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=homelab.target
