# Copy to ~/.config/restic/restic.env on the Pi and edit. The real file is
# never committed (*.env is gitignored; only *.env.example files are).
#
# Where the encrypted backups are stored. They stay on the Pi; you pull a copy
# to your Mac with scripts/pull-backup.sh (Mac -> Pi, the Pi never connects out).
# Replace CHANGE_ME with your username.
RESTIC_REPOSITORY=/home/CHANGE_ME/backups/restic

# File holding the repository password. Create it once with:
#   openssl rand -base64 32 > ~/.config/restic/password && chmod 600 ~/.config/restic/password
# SAVE A COPY IN YOUR PASSWORD MANAGER. Without it the backups are unreadable.
RESTIC_PASSWORD_FILE=/home/CHANGE_ME/.config/restic/password
